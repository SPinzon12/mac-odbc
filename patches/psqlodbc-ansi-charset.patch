+
+/*
+ *	SQL_C_CHAR charset override (non-Windows).
+ *
+ *	Some ANSI applications decode SQL_C_CHAR data with a fixed legacy
+ *	charset instead of UTF-8 (Excel for Mac uses Mac Roman). PostgreSQL has
+ *	no such client encoding and macOS has no such locale, so the conversion
+ *	is done here with iconv when the DSN sets AnsiCharset.
+ */
+static char	ansi_charset[64];
+
+void set_ansi_charset(const char *charset)
+{
+	if (charset)
+		strncpy_null(ansi_charset, charset, sizeof(ansi_charset));
+	else
+		ansi_charset[0] = '\0';
+#ifndef	WIN32
+	/* an unknown charset name is ignored rather than failing every row */
+	if (ansi_charset_active())
+	{
+		iconv_t	cd = iconv_open(ansi_charset, "UTF-8");
+
+		if ((iconv_t) -1 == cd)
+		{
+			MYLOG(0, "unknown ansi charset \"%s\" ignored\n", ansi_charset);
+			ansi_charset[0] = '\0';
+		}
+		else
+			iconv_close(cd);
+	}
+#else
+	ansi_charset[0] = '\0';
+#endif /* WIN32 */
+	MYLOG(0, "ansi charset=\"%s\"\n", ansi_charset);
+}
+
+BOOL ansi_charset_active(void)
+{
+	return '\0' != ansi_charset[0];
+}
+
+#ifndef	WIN32
+static size_t utf8_seq_len(UCHAR lead)
+{
+	if (lead < 0x80)
+		return 1;
+	if (0xc0 == (lead & 0xe0))
+		return 2;
+	if (0xe0 == (lead & 0xf0))
+		return 3;
+	if (0xf0 == (lead & 0xf8))
+		return 4;
+	return 1;
 }
+#endif /* WIN32 */
+
+/*
+ *	Returns a malloc'ed copy of utf8str converted to the AnsiCharset, or
+ *	NULL on failure. Characters the charset lacks become '?': //TRANSLIT is
+ *	requested, but the BSD iconv in macOS ignores it and stops instead.
+ */
+char *utf8_to_ansi_charset(const char *utf8str)
+{
+#ifdef	WIN32
+	return NULL;
+#else
+	char	tocode[sizeof(ansi_charset) + 16];
+	size_t	inleft = strlen(utf8str), outcap = inleft * 4 + 1, outleft, skip;
+	char	*in = (char *) utf8str, *out, *outbuf;
+	iconv_t	cd;
+
+	snprintf(tocode, sizeof(tocode), "%s//TRANSLIT", ansi_charset);
+	if ((iconv_t) -1 == (cd = iconv_open(tocode, "UTF-8")) &&
+	    (iconv_t) -1 == (cd = iconv_open(ansi_charset, "UTF-8")))
+	{
+		MYLOG(0, "iconv_open(%s) failed\n", ansi_charset);
+		return NULL;
+	}
+	if (NULL == (outbuf = malloc(outcap)))
+	{
+		iconv_close(cd);
+		return NULL;
+	}
+	out = outbuf;
+	outleft = outcap - 1;
+	while (inleft > 0)
+	{
+		if ((size_t) -1 != iconv(cd, &in, &inleft, &out, &outleft))
+			break;
+		if ((EILSEQ != errno && EINVAL != errno) || outleft < 1)
+		{
+			MYLOG(0, "iconv to %s failed at byte " FORMAT_SIZE_T "\n", ansi_charset, (size_t) (in - utf8str));
+			free(outbuf);
+			iconv_close(cd);
+			return NULL;
+		}
+		/* not representable (or truncated input): substitute and move on */
+		*out++ = '?';
+		outleft--;
+		skip = utf8_seq_len((UCHAR) *in);
+		if (skip > inleft)
+			skip = inleft;
+		in += skip;
+		inleft -= skip;
+		iconv(cd, NULL, NULL, NULL, NULL);
+	}
+	*out = '\0';
+	iconv_close(cd);
+	return outbuf;
+#endif /* WIN32 */
+}
 #endif	/* UNICODE_SUPPORT */
